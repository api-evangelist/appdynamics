{
  "info": {
    "_postman_id": "4676c501-2655-4e4a-a869-00973241d68c",
    "name": "AppDynamics OAuth Authentication OAuth Tokens API",
    "description": "The AppDynamics OAuth Authentication API enables developers to generate short-lived access tokens using the OAuth 2.0 Client Credentials Grant flow. API clients can request access tokens to authenticate against AppDynamics APIs securely without using long-lived credentials. This API is used in conjunction with both the on-premises Controller and the Cisco Observability Platform to manage API client credentials and control access to the various AppDynamics platform services and endpoints.\n\nContact Support:\n Name: Splunk AppDynamics Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:13:28.000Z",
    "updatedAt": "2026-10-22T01:13:28.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-4676c501-2655-4e4a-a869-00973241d68c"
  },
