        {
          "name": "oauth",
          "item": [
            {
              "name": "access_token",
              "item": [
                {
                  "name": "Generate an OAuth access token",
                  "id": "ba041486-bd3a-440b-8828-aacff34b75e0",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/x-www-form-urlencoded"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "urlencoded",
                      "urlencoded": [
                        {
                          "description": "(Required) The OAuth 2.0 grant type. Must be set to client_credentials.",
                          "key": "grant_type",
                          "value": "client_credentials"
                        },
                        {
                          "description": "(Required) The API client name in the format clientName@accountName. The account name is your AppDynamics account identifier.",
                          "key": "client_id",
                          "value": "<string>"
                        },
                        {
                          "description": "(Required) The client secret generated when creating the API client in the Controller.",
                          "key": "client_secret",
                          "value": "<string>"
                        }
                      ]
                    },
                    "url": {
                      "raw": "{{baseUrl}}/api/oauth/access_token",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "api",
                        "oauth",
                        "access_token"
                      ]
                    },
                    "description": "Generates a short-lived OAuth 2.0 access token using the Client Credentials Grant flow. The access token can be used in the Authorization header for subsequent API calls. Tokens have a configurable expiration period with a default of five minutes."
                  },
                  "response": [
                    {
                      "id": "41e97712-3586-46b8-8075-258efa8a9a36",
                      "name": "Access token generated successfully",
