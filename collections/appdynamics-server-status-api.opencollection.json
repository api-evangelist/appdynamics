{
  "opencollection": "1.0.0",
  "info": {
    "name": "AppDynamics Alert and Respond Actions Server Status API",
    "version": "23.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Server Status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Controller server status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{controller-host}/controller/rest/serverstatus"
          },
          "docs": "Returns the current status of the AppDynamics Controller server."
        }
      ]
    }
  ],
  "bundled": true
}