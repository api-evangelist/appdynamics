    "name": "AppDynamics Machine Agent Custom Metrics API",
    "description": "The AppDynamics Machine Agent API provides HTTP endpoints available at the machine agent for uploading custom metrics to the AppDynamics Controller.\n\nContact Support:\n Name: Splunk AppDynamics Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
