              "name": "metrics",
              "item": [
                {
                  "name": "Publish custom metrics",
                  "id": "3bebf53f-7658-4a50-933e-bc90880859f7",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "[\n  {\n    \"metricName\": \"<string>\",\n    \"aggregatorType\": \"ADVANCED_AVERAGE\",\n    \"value\": \"<long>\"\n  },\n  {\n    \"metricName\": \"<string>\",\n    \"aggregatorType\": \"AVERAGE\",\n    \"value\": \"<long>\"\n  }\n]",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/api/v1/metrics",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "api",
                        "v1",
                        "metrics"
                      ]
                    },
                    "description": "Uploads one or more custom metrics to the AppDynamics Controller through the Machine Agent. Metrics must be uploaded at least once every 300 seconds (5 minutes) to remain active in the metric hierarchy. Each metric requires a name, aggregator type, and a 64-bit integer value."
                  },
