      "id": "f0e78d4d-ccd3-44f4-9685-19f74563a625",
      "name": "Custom Metrics",
      "description": {
        "content": "Upload custom metrics to the AppDynamics Controller through the Machine Agent HTTP listener. Metrics must be uploaded at least once every 300 seconds to remain active.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f0028709-8fbe-4332-b879-3697f3e493ad",
          "name": "Publish custom metrics",
          "request": {
            "name": "Publish custom metrics",
            "description": {
              "content": "Uploads one or more custom metrics to the AppDynamics Controller through the Machine Agent. Metrics must be uploaded at least once every 300 seconds (5 minutes) to remain active in the metric hierarchy. Each metric requires a name, aggregator type, and a 64-bit integer value.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "metrics"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The hostname of your AppDynamics Controller instance.",
                  "type": "any",
                  "value": "{{controller-host}}",
                  "key": "controller-host"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"metricName\": \"<string>\",\n    \"aggregatorType\": \"<string>\",\n    \"value\": \"<long>\"\n  },\n  {\n    \"metricName\": \"<string>\",\n    \"aggregatorType\": \"<string>\",\n    \"value\": \"<long>\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
