          "name": "Import actions for an application",
          "request": {
            "name": "Import actions for an application",
            "description": {
              "content": "Imports action configurations from an XML file into the specified application.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "actions",
                ":applicationId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "overwrite",
                  "value": "false",
                  "description": "When true, overwrites existing actions with matching names."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "applicationId",
                  "description": "(Required) The numeric ID of the business application."
                },
                {
                  "description": "The hostname of your AppDynamics Controller instance.",
                  "type": "any",
                  "value": "{{controller-host}}",
                  "key": "controller-host"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "The XML file containing the action configurations to import."
                }
              ]
