{
  "item": [
    {
      "id": "2c585774-59eb-4056-a85e-ed1da541f0de",
      "name": "Snapshots",
      "description": {
        "content": "Retrieve transaction request snapshots for detailed performance analysis of individual requests.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c61e679a-4287-4c9e-b0b5-7d653f8aabf1",
          "name": "List request snapshots for an application",
          "request": {
            "name": "List request snapshots for an application",
            "description": {
              "content": "Returns transaction request snapshots for the specified application and time range. Snapshots capture detailed information about individual request executions including call graphs, data collectors, and error details.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "applications",
                ":applicationId",
                "request-snapshots"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "time-range-type",
                  "value": "<string>",
                  "description": "(Required) The type of time range for the snapshot query."
                },
                {
                  "disabled": false,
                  "key": "duration-in-mins",
                  "value": "<integer>",
                  "description": "Duration in minutes for BEFORE_NOW and BEFORE_TIME time range types."
                },
                {
                  "disabled": false,
                  "key": "start-time",
                  "value": "<long>",
                  "description": "Start time in Unix epoch milliseconds."
                },
                {
                  "disabled": false,
                  "key": "end-time",
                  "value": "<long>",
                  "description": "End time in Unix epoch milliseconds."
                },
                {
                  "disabled": false,
                  "key": "guids",
                  "value": "<string>",
                  "description": "Comma-separated list of snapshot GUIDs to retrieve specific snapshots."
                },
                {
                  "disabled": false,
                  "key": "archived",
                  "value": "<boolean>",
                  "description": "When true, includes archived snapshots in the results."
                },
                {
                  "disabled": false,
                  "key": "deep-dive-policy",
                  "value": "<string>",
                  "description": "Filter snapshots by the deep-dive policy that triggered them."
                },
                {
                  "disabled": false,
                  "key": "application-component-ids",
                  "value": "<string>",
                  "description": "Comma-separated list of tier IDs to filter snapshots."
                },
                {
                  "disabled": false,
                  "key": "business-transaction-ids",
                  "value": "<string>",
                  "description": "Comma-separated list of business transaction IDs to filter snapshots."
                },
                {
                  "disabled": false,
                  "key": "user-experience",
                  "value": "<string>",
                  "description": "Filter by user experience classification."
                },
                {
                  "disabled": false,
                  "key": "first-in-chain",
                  "value": "<boolean>",
                  "description": "When true, only returns the first snapshot in a cross-application call chain."
                },
                {
                  "disabled": false,
                  "key": "need-props",
                  "value": "<boolean>",
                  "description": "When true, includes data collector properties in the response."
                },
                {
                  "disabled": false,
                  "key": "need-exit-calls",
                  "value": "<boolean>",
                  "description": "When true, includes exit call details in the response."
                },
                {
                  "disabled": false,
                  "key": "execution-time-in-millis-greater-than",
                  "value": "<integer>",
                  "description": "Filter for snapshots with execution time greater than this value in milliseconds."
                },
                {
                  "disabled": false,
                  "key": "data-collector-name",
                  "value": "<string>",
                  "description": "Filter by data collector name."
                },
                {
                  "disabled": false,
                  "key": "data-collector-type",
                  "value": "<string>",
                  "description": "Filter by data collector type."
                },
                {
                  "disabled": false,
                  "key": "data-collector-value",
                  "value": "<string>",
                  "description": "Filter by data collector value."
                },
                {
                  "disabled": false,
                  "key": "output",
                  "value": "XML",
                  "description": "The output format for the response. Defaults to XML if not specified."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "applicationId",
                  "description": "(Required) The numeric ID or name of the business application."
                },
                {
                  "description": "The hostname of your AppDynamics Controller instance.",
                  "type": "any",
                  "value": "{{controller-host}}",
                  "key": "controller-host"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
