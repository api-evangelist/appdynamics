          "item": [
            {
              "name": "Query analytics events using ADQL",
              "id": "f41d453f-5692-4bc7-8517-c47f688d2c83",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "description": "(Required) The AppDynamics account name for authentication.",
                    "key": "X-Events-API-AccountName",
                    "value": "<string>"
                  },
                  {
                    "description": "(Required) The API key for authenticating with the Events Service.",
                    "key": "X-Events-API-Key",
                    "value": "<string>"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/vnd.appd.events+json;v=2"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "[\n  {\n    \"query\": \"<string>\",\n    \"mode\": \"<string>\",\n    \"limit\": \"<integer>\"\n  },\n  {\n    \"query\": \"<string>\",\n    \"mode\": \"<string>\",\n    \"limit\": \"<integer>\"\n  }\n]",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/events/query?start=<string>&end=<string>&limit=<integer>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "events",
                    "query"
                  ],
                  "query": [
                    {
                      "description": "The start time for the query in ISO 8601 format or relative time notation.",
                      "key": "start",
                      "value": "<string>"
                    },
                    {
                      "description": "The end time for the query in ISO 8601 format or relative time notation.",
                      "key": "end",
                      "value": "<string>"
                    },
                    {
                      "description": "The maximum number of results to return.",
                      "key": "limit",
                      "value": "<integer>"
                    }
                  ]
                },
                "description": "Executes an Analytics Query Language (ADQL) query against stored events and returns the results. Supports both simple text-formatted queries and JSON-formatted queries that accommodate multiple queries per call. Rate limited to 450 requests per minute per account and 145 requests per minute per API key."
              },
