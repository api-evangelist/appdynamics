                      "key": "grant_type",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) The API client name in the format clientName@accountName. The account name is your AppDynamics account identifier.",
                        "type": "text/plain"
