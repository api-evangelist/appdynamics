          "request": {
            "name": "Generate a Cisco Observability Platform access token",
            "description": {
              "content": "Generates an OAuth 2.0 access token for the Cisco Observability Platform using the Client Credentials Grant flow. Used to authenticate against the Cloud Observability APIs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                ":tenantId",
                "default",
                "oauth2",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "tenantId",
                  "description": "(Required) The tenant identifier for your Cisco Observability Platform account."
                },
                {
                  "description": "The hostname of your AppDynamics Controller instance.",
                  "type": "any",
                  "value": "{{controller-host}}",
                  "key": "controller-host"
