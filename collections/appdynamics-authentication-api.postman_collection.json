  "info": {
    "_postman_id": "2e1bb2cd-c5f5-4e2a-9490-e5970a3bfea9",
    "name": "AppDynamics OAuth Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The AppDynamics OAuth Authentication API enables developers to generate short-lived access tokens using the OAuth 2.0 Client Credentials Grant flow. API clients can request access tokens to authenticate against AppDynamics APIs securely without using long-lived credentials. This API is used in conjunction with both the on-premises Controller and the Cisco Observability Platform to manage API client credentials and control access to the various AppDynamics platform services and endpoints.\n\nContact Support:\n Name: Splunk AppDynamics Support",
      "type": "text/plain"
    }
  }
