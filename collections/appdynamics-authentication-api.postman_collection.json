  "item": [
    {
      "id": "c16fb3f6-0872-4617-ac68-db80d6a4c3c1",
      "name": "OAuth Tokens",
      "description": {
        "content": "Generate and manage OAuth 2.0 access tokens for authenticating against AppDynamics APIs using the Client Credentials Grant flow.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f6198e58-34b7-4411-a09a-279b70eb7c1d",
          "name": "Generate an OAuth access token",
          "request": {
            "name": "Generate an OAuth access token",
            "description": {
              "content": "Generates a short-lived OAuth 2.0 access token using the Client Credentials Grant flow. The access token can be used in the Authorization header for subsequent API calls. Tokens have a configurable expiration period with a default of five minutes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "oauth",
                "access_token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The hostname of your AppDynamics Controller instance.",
                  "type": "any",
                  "value": "{{controller-host}}",
                  "key": "controller-host"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) The OAuth 2.0 grant type. Must be set to client_credentials."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The API client name in the format clientName@accountName. The account name is your AppDynamics account identifier."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "(Required) The client secret generated when creating the API client in the Controller."
                }
              ]
            }
          },
          "response": [
            {
              "id": "7150c999-5d69-45d5-84f6-54b8bbc1d6c0",
              "name": "Access token generated successfully",
              "originalRequest": {
