{
  "opencollection": "1.0.0",
  "info": {
    "name": "AppDynamics Alert and Respond Actions Events API",
    "version": "23.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Publish custom analytics events",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{controller-host}/controller/events/publish/:schemaName",
            "headers": [
              {
                "name": "X-Events-API-AccountName",
                "value": ""
              },
              {
                "name": "X-Events-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "schemaName",
                "value": "",
                "type": "path",
                "description": "The name of the custom event schema."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Publishes one or more custom analytics events to the Events Service under the specified schema name. Events must conform to the schema definition."
        }
      ]
    }
  ],
  "bundled": true
}