      "item": [
        {
          "id": "f4d3252d-9a38-4d18-9da4-ba0426a10c3c",
          "name": "List metric hierarchy for an application",
          "request": {
            "name": "List metric hierarchy for an application",
            "description": {
              "content": "Returns the metric tree hierarchy for the specified application. Use this to discover available metric paths before retrieving metric data. Supports wildcard characters in the metric-path parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "applications",
                ":applicationId",
                "metrics"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "metric-path",
                  "value": "<string>",
                  "description": "The metric path to browse. Supports wildcard characters. If not specified, returns the top level of the metric hierarchy."
                },
                {
                  "disabled": false,
                  "key": "output",
                  "value": "XML",
                  "description": "The output format for the response. Defaults to XML if not specified."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "applicationId",
                  "description": "(Required) The numeric ID or name of the business application."
                },
                {
                  "description": "The hostname of your AppDynamics Controller instance.",
                  "type": "any",
                  "value": "{{controller-host}}",
                  "key": "controller-host"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
