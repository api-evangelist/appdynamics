{
  "info": {
    "_postman_id": "8b496300-e06d-4910-b3e4-297d3e4c6ca6",
    "name": "AppDynamics Metric and Snapshot Metrics API",
    "description": "The AppDynamics Metric and Snapshot API allows developers to retrieve metric data and transaction snapshots from monitored applications. It supports configurable time ranges, data aggregation through rollup parameters, and access to various metric types including response times, error rates, and call volumes. Developers can retrieve request snapshots for detailed transaction analysis and configure metric retention periods to control how long performance data is stored.\n\nContact Support:\n Name: Splunk AppDynamics Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:13:12.000Z",
    "updatedAt": "2026-10-22T01:13:13.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-8b496300-e06d-4910-b3e4-297d3e4c6ca6"
  },
