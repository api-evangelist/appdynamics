                {
                  "name": "metric-data",
                  "item": [
                    {
                      "name": "Get metric data for an application",
                      "id": "ab3bb73b-f831-4498-a402-62206e8c1b16",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "GET",
                        "header": [
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "url": {
                          "raw": "{{baseUrl}}/rest/applications/:applicationId/metric-data?metric-path=<string>&time-range-type=BEFORE_TIME&duration-in-mins=<integer>&start-time=<long>&end-time=<long>&rollup=true&output=XML",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "rest",
                            "applications",
                            ":applicationId",
                            "metric-data"
                          ],
                          "query": [
                            {
                              "description": "(Required) The full metric path to retrieve data for. Supports wildcard characters using the pipe delimiter for path levels.",
                              "key": "metric-path",
                              "value": "<string>"
                            },
                            {
                              "description": "(Required) The type of time range to use for the query.",
                              "key": "time-range-type",
                              "value": "BEFORE_TIME"
                            },
                            {
                              "description": "Duration in minutes for BEFORE_NOW and BEFORE_TIME time range types.",
                              "key": "duration-in-mins",
                              "value": "<integer>"
                            },
                            {
                              "description": "Start time in Unix epoch milliseconds for AFTER_TIME and BETWEEN_TIMES time range types.",
                              "key": "start-time",
                              "value": "<long>"
                            },
                            {
                              "description": "End time in Unix epoch milliseconds for BEFORE_TIME and BETWEEN_TIMES time range types.",
                              "key": "end-time",
                              "value": "<long>"
                            },
                            {
                              "description": "When true, aggregates data into a single data point. When false, returns individual data points. Defaults to true.",
                              "key": "rollup",
                              "value": "true"
                            },
                            {
                              "description": "The output format for the response. Defaults to XML if not specified.",
                              "key": "output",
                              "value": "XML"
                            }
                          ],
                          "variable": [
                            {
                              "id": "628603ff-4ca0-48c5-8276-68bd05cf44fe",
                              "key": "applicationId",
                              "value": "<string>",
                              "description": "(Required) The numeric ID or name of the business application."
                            }
                          ]
                        },
                        "description": "Returns metric data for the specified metric path and time range. The rollup parameter controls whether data is aggregated into a single value or returned as individual data points. Supports wildcard characters in the metric-path parameter."
                      },
