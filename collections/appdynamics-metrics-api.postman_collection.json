        {
          "id": "4d6f0f48-fdc2-4ebc-8d06-c88ea669410b",
          "name": "Get metric data for an application",
          "request": {
            "name": "Get metric data for an application",
            "description": {
              "content": "Returns metric data for the specified metric path and time range. The rollup parameter controls whether data is aggregated into a single value or returned as individual data points. Supports wildcard characters in the metric-path parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "applications",
                ":applicationId",
                "metric-data"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "metric-path",
                  "value": "<string>",
                  "description": "(Required) The full metric path to retrieve data for. Supports wildcard characters using the pipe delimiter for path levels."
                },
                {
                  "disabled": false,
                  "key": "time-range-type",
                  "value": "<string>",
                  "description": "(Required) The type of time range to use for the query."
                },
                {
                  "disabled": false,
                  "key": "duration-in-mins",
                  "value": "<integer>",
                  "description": "Duration in minutes for BEFORE_NOW and BEFORE_TIME time range types."
                },
                {
                  "disabled": false,
                  "key": "start-time",
                  "value": "<long>",
                  "description": "Start time in Unix epoch milliseconds for AFTER_TIME and BETWEEN_TIMES time range types."
                },
                {
                  "disabled": false,
                  "key": "end-time",
                  "value": "<long>",
                  "description": "End time in Unix epoch milliseconds for BEFORE_TIME and BETWEEN_TIMES time range types."
                },
                {
                  "disabled": false,
                  "key": "rollup",
                  "value": "true",
                  "description": "When true, aggregates data into a single data point. When false, returns individual data points. Defaults to true."
                },
                {
                  "disabled": false,
                  "key": "output",
                  "value": "XML",
                  "description": "The output format for the response. Defaults to XML if not specified."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "applicationId",
                  "description": "(Required) The numeric ID or name of the business application."
                },
                {
                  "description": "The hostname of your AppDynamics Controller instance.",
                  "type": "any",
                  "value": "{{controller-host}}",
                  "key": "controller-host"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "196bcdf4-132c-4927-986e-69b7aae869a6",
              "name": "Successful retrieval of metric data",
              "originalRequest": {
