        {
          "id": "516e16e8-8e63-426c-a8a7-7487562116af",
          "name": "Export health rules for an application",
          "request": {
            "name": "Export health rules for an application",
            "description": {
              "content": "Exports all health rules for the specified application as an XML document. The exported configuration can be imported into another application or Controller instance.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "healthrules",
                ":applicationId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "The name of a specific health rule to export. If omitted, all health rules are exported."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "applicationId",
                  "description": "(Required) The numeric ID of the business application."
                },
                {
                  "description": "The hostname of your AppDynamics Controller instance.",
                  "type": "any",
                  "value": "{{controller-host}}",
                  "key": "controller-host"
                }
              ]
            },
            "header": [
