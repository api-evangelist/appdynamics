        {
          "id": "ae673a09-6c81-4cbf-accd-d85a964763d5",
          "name": "Import health rules for an application",
          "request": {
            "name": "Import health rules for an application",
            "description": {
              "content": "Imports health rule configurations from an XML file into the specified application. Existing health rules with matching names can be overwritten.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "healthrules",
                ":applicationId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "overwrite",
                  "value": "false",
                  "description": "When true, overwrites existing health rules with matching names."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "applicationId",
                  "description": "(Required) The numeric ID of the business application."
                },
                {
                  "description": "The hostname of your AppDynamics Controller instance.",
                  "type": "any",
                  "value": "{{controller-host}}",
                  "key": "controller-host"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "The XML file containing the health rule configuration to import."
                }
              ]
            }
          },
          "response": [
