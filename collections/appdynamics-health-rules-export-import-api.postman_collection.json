            {
              "name": "Export health rules for an application",
              "id": "6971c071-b5c8-4640-99e2-daa2e7181305",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/xml"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/healthrules/:applicationId?name=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "healthrules",
                    ":applicationId"
                  ],
                  "query": [
                    {
                      "description": "The name of a specific health rule to export. If omitted, all health rules are exported.",
                      "key": "name",
                      "value": "<string>"
                    }
                  ],
                  "variable": [
                    {
                      "id": "b9dc983f-21ab-42a8-93a7-1f40dfed75d1",
                      "key": "applicationId",
                      "value": "<long>",
                      "description": "(Required) The numeric ID of the business application."
                    }
                  ]
                },
                "description": "Exports all health rules for the specified application as an XML document. The exported configuration can be imported into another application or Controller instance."
              },
